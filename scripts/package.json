  "private": true,
  "type": "module",
  "description": "One-off scripts for the portfolio site. Not part of the Pages deploy.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "migrate:dry": "node --env-file=.env migrate-photos.js --dry-run",
